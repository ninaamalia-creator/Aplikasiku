{
  "name": "Lensa PDF",
  "short_name": "Lensa PDF",
  "description": "Baca PDF dan cari kata di dalamnya, tanpa menyimpan dokumen.",
  "lang": "id",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#d32027",
  "theme_color": "#d32027",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf"] }]
    }
  }
}
